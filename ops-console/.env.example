# ─── Database ──────────────────────────────────────────────
# URL de conexión directa a PostgreSQL con el usuario ops_console_user
# Este usuario tiene el rol platform_admin_role (BYPASSRLS)
OPS_DATABASE_URL=postgresql://ops_console_user:password@postgres:5432/consultorio_medico

# ─── Auth ───────────────────────────────────────────────────
# Secreto para firmar JWT de sesión (openssl rand -hex 32)
OPS_JWT_SECRET=your-jwt-secret-here

# Pepper extra para setup tokens (openssl rand -hex 16)
OPS_SETUP_TOKEN_PEPPER=your-setup-pepper-here

# ─── Bootstrap ─────────────────────────────────────────────
# Email y nombre del primer operador (bootstrap-ops.ts)
OPS_SETUP_EMAIL=admin@aicorebots.com
OPS_SETUP_NOMBRE=Admin

# ─── Observability (Sentry / GlitchTip) ────────────────────
GLITCHTIP_DSN=https://key@glitchtip.aicorebots.com/project
NEXT_PUBLIC_GLITCHTIP_DSN=https://key@glitchtip.aicorebots.com/project
SENTRY_TRACES_SAMPLE_RATE=0.1

# API REST de Sentry/GlitchTip para el feed de errores (ops-console)
# Base URL de la API (US: https://app.glitchtip.com, EU: https://eu.glitchtip.com, Sentry SaaS: https://sentry.io)
SENTRY_API_URL=https://app.glitchtip.com
# Token de acceso creado en GlitchTip > Profile > Auth Tokens (scopes: event:read, org:read, project:read)
SENTRY_AUTH_TOKEN=
# Slug de la organización en GlitchTip/Sentry
SENTRY_ORG=
# ID del proyecto (por defecto 25899 para el dashboard de AicoreMed)
SENTRY_PROJECT=25899

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ops.aicorebots.com
NODE_ENV=production
TZ=America/Santiago

# ─── Impersonation ──────────────────────────────────────────
# URL del dashboard para proxy de impersonación.
# En producción usar la URL interna Swarm (http://med-dashboard:3000) para
# evitar Cloudflare, que devuelve HTML 403/404 y rompe el JSON.
DASHBOARD_INTERNAL_URL=http://med-dashboard:3000
# Fallback público (dev/tests)
DASHBOARD_URL=https://med.aicorebots.com
# Internal API Key compartida con el dashboard
INTERNAL_API_KEY=run-openssl-rand-base64-32-to-generate
