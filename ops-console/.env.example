# ─── Database ──────────────────────────────────────────────
# URL de conexión directa a PostgreSQL con el usuario ops_console_user
# Este usuario tiene el rol platform_admin_role (BYPASSRLS)
OPS_DATABASE_URL=postgresql://ops_console_user:password@postgres:5432/consultorio_medico

# ─── Auth ───────────────────────────────────────────────────
# Secreto para firmar JWT de sesión (openssl rand -hex 32)
OPS_JWT_SECRET=your-jwt-secret-here

# Pepper extra para setup tokens (openssl rand -hex 16)
OPS_SETUP_TOKEN_PEPPER=your-setup-pepper-here

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ops.aicorebots.com
NODE_ENV=production
TZ=America/Santiago
